{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdv",
  "version": "0.1.0",
  "identifier": "com.jvanderberg.mdv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdv",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$TEMP/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/Help.md"],
    "icon": ["icons/MDV.png"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "txt"],
        "name": "Markdown",
        "description": "Markdown or plain text document",
        "role": "Viewer"
      }
    ]
  }
}
